# Copy to .env and fill in real values. NEVER commit .env.

# Port the server listens on (Render/Fly/Railway will inject their own).
PORT=3000

# Single shared password for the reader. Change this. Long, random, unique.
READER_PASSWORD=change-me-to-a-long-random-string

# Used to sign session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Optional reader name shown in watermark, e.g. "Beta Reader: Jane".
# Leave blank to use the random session id only.
READER_LABEL=

# Set to "production" when deployed (enables secure cookies, HTTPS-only).
NODE_ENV=development
